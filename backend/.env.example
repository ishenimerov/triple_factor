# Copy this file to ".env" and fill in the values.

# Port the API server listens on
PORT=4000

# Secret used to sign JWTs and intermediate stage tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# Lifetime of the final session JWT
JWT_EXPIRES_IN=1h

# --- Email (OTP delivery) ---------------------------------------------------
# Leave EMAIL_MODE=ethereal to auto-create a fake test inbox (no real emails
# are sent; a preview URL is printed to the server console instead).
# Set EMAIL_MODE=smtp and fill the SMTP_* values to send real email
# (e.g. a Gmail account with an App Password).
EMAIL_MODE=ethereal

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="3FA Social <no-reply@example.com>"

# Testing convenience ONLY: when set to 1, the /login/password response also
# returns the plaintext OTP so automated tests / graders don't need to read the
# email. Leave unset (or 0) for any realistic run — it defeats the second factor.
DEV_RETURN_OTP=0
